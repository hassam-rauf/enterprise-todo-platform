# --- Kafka (Phase 5: Event Streaming) ---
# Set to your Kafka broker(s). Leave empty to disable Kafka (app starts without it).
# Start Kafka locally: docker compose -f cloud/kafka/docker-compose.kafka.yml up -d
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Optional prefix for all topic names (e.g. "dev-"). Default: empty (no prefix).
KAFKA_TOPIC_PREFIX=
